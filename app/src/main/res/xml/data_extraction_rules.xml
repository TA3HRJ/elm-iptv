<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of the app's data leaves the device through the system's cloud backup or a device-to-device
  transfer: the database holds the playlists' logins and the settings hold the parental PIN's hash.
  The app's own backup (Settings > Backup, optionally with a password) is the way to move data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
